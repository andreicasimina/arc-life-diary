# Google Gemini API key (strictly loaded by arc-life-diary from this file)
GEMINI_API_KEY=your_gemini_api_key_here

# Directory containing YYYY-MM-DD.md journal entries (defaults to ./entries)
DIARY_ENTRIES_DIR=./entries

# Local SQLite database path (defaults to ./diary.db)
DIARY_DB_PATH=./diary.db

# Optional Google Drive parent folder ID for encrypted backups (defaults to root if empty)
# GDRIVE_FOLDER_ID=your_gdrive_folder_id_here
